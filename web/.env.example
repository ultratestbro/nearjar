# Everything is optional for running the site locally: jars are read from mainnet, quotes come from the public
# 1Click API and statuses go to local.db. The variables left blank below can stay blank: the code treats an empty
# value as unset. Keep the commented-out overrides commented out unless you set them: an empty value there would
# replace the built-in default.

# near.com account the developer's support jar (/j/support, id "demo") pays; blank: no support jar
NEARJAR_DEMO_OWNER=
# mainnet by default; "testnet" switches the RPC and expects a testnet contract
NEARJAR_NETWORK=mainnet
NEARJAR_CONTRACT=nearjar.near
NEAR_RPC_URL=https://free.rpc.fastnear.com
# public site URL for the TON Connect manifest (defaults to the request origin)
# NEARJAR_PUBLIC_URL=

# relayer: a function-call key limited to the contract (submit, record_donation); needed to create jars
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=

# 1Click partner JWT: Confidential delivery and no 1Click fee (without it: public intents balance, 0.2% fee)
ONE_CLICK_JWT=
# override the 1Click API base URL (defaults to the public one)
# ONE_CLICK_API_URL=

# private nodes for sending Solana and TON donations (public endpoints are used otherwise)
# SOLANA_RPC_URL=
# TON_RPC_URL=

# hosted database instead of local.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Reown project id: needed to connect any EVM or Solana wallet (extensions and phone wallets both go through
# Reown AppKit); NEAR, TON, Tron and Bitcoin wallets work without it
NEXT_PUBLIC_REOWN_PROJECT_ID=
